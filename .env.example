# Numeric forecasting uses read-only KIS market data.
# The active forecast package does not use order, Telegram, dashboard, news,
# Gemini, or LLM settings.

# 한국투자증권 — 모의 데이터 조회
KIS_MOCK_APP_KEY=
KIS_MOCK_APP_SECRET=

# 한국투자증권 — 실전 시장데이터 조회
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=

# true=모의 서버, false=실전 시장데이터 서버
KIS_IS_MOCK=true

# DART 전자공시 구조화 API
# https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# 예측 artifact 저장 위치
FORECAST_ARTIFACT_DIR=data/forecast
