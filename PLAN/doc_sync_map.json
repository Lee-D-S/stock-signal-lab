{
  "default_docs": [
    "AGENTS.md",
    "forecast/README.md",
    "docs/architecture/README.md"
  ],
  "rules": [
    {
      "id": "forecast_pipeline",
      "patterns": [
        "forecast/**",
        ".github/workflows/forecast_*.yml",
        "config.py",
        "requirements.txt"
      ],
      "docs": [
        "AGENTS.md",
        "forecast/README.md",
        "docs/architecture/runtime-flows.md",
        "docs/architecture/data-model.md"
      ],
      "reason": "Forecast data contracts, schedules, dependencies, or runtime behavior changed."
    },
    {
      "id": "historical_analysis_paths",
      "patterns": [
        "scripts/analysis_paths.py",
        "scripts/sync_analysis_paths.py",
        "ai 주가 변동 원인 분석/**"
      ],
      "docs": [
        "AGENTS.md",
        "docs/architecture/README.md"
      ],
      "reason": "Preserved historical analysis paths or their maintenance tooling changed."
    },
    {
      "id": "doc_sync_tooling",
      "patterns": [
        "scripts/check_docs_sync.py",
        "PLAN/doc_sync_map.json"
      ],
      "docs": [
        "AGENTS.md",
        "forecast/README.md"
      ],
      "reason": "Documentation sync workflow or candidate selection changed."
    }
  ]
}
